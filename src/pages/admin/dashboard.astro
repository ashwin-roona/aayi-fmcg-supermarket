---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin Dashboard">
<div class="min-h-screen bg-gray-50 flex flex-col">

  <!-- ═══ TOP HEADER ════════════════════════════════════════════════ -->
  <header class="bg-white border-b border-gray-100 sticky top-0 z-50 shadow-sm">
    <div class="px-4 sm:px-6 h-16 flex items-center gap-4">
      <!-- Logo -->
      <div class="flex items-center gap-3 shrink-0">
        <div class="w-9 h-9 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center shadow-md shadow-primary-600/30">
          <i class="fa-solid fa-leaf text-white text-sm"></i>
        </div>
        <div class="hidden sm:block">
          <div class="font-black text-gray-900 text-sm leading-none">AAYI Mart</div>
          <div class="text-[10px] font-bold text-primary-500 tracking-widest uppercase mt-0.5">Admin</div>
        </div>
      </div>

      <!-- Breadcrumb / page title -->
      <div class="flex-1 ml-2 hidden md:block">
        <div id="breadcrumb" class="text-sm text-gray-400 font-medium flex items-center gap-2">
          <i class="fa-solid fa-house text-xs text-gray-300"></i>
          <span>Dashboard</span>
        </div>
      </div>

      <!-- Right actions -->
      <div class="ml-auto flex items-center gap-3">
        <a href="/" target="_blank"
          class="hidden sm:flex items-center gap-2 text-sm text-gray-500 hover:text-primary-600 hover:bg-primary-50 transition-all px-4 py-2 rounded-xl font-medium border border-gray-200 hover:border-primary-200">
          <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
          <span>View Store</span>
        </a>
        <!-- Avatar / user -->
        <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-gray-50 border border-gray-200">
          <div class="w-7 h-7 bg-gradient-to-br from-primary-500 to-primary-700 rounded-lg flex items-center justify-center">
            <i class="fa-solid fa-user text-white text-xs"></i>
          </div>
          <span class="text-sm font-bold text-gray-700 hidden sm:block">admin</span>
        </div>
        <button id="logout-btn"
          class="flex items-center gap-2 bg-red-50 hover:bg-red-100 text-red-600 font-bold text-sm px-4 py-2 rounded-xl border border-red-100 hover:border-red-200 transition-all">
          <i class="fa-solid fa-right-from-bracket text-xs"></i>
          <span class="hidden sm:block">Logout</span>
        </button>
      </div>
    </div>
  </header>

  <div class="flex flex-1 overflow-hidden">

    <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════ -->
    <aside class="w-64 bg-[#0f1623] hidden md:flex flex-col pt-6 pb-8 px-4 shrink-0">
      <!-- Nav label -->
      <div class="text-[10px] font-black text-gray-600 uppercase tracking-widest px-3 mb-3">Navigation</div>

      <nav class="flex flex-col gap-1">
        <button class="admin-nav-btn active" data-section="overview">
          <span class="nav-icon bg-primary-600"><i class="fa-solid fa-gauge-high"></i></span>
          Overview
        </button>
        <button class="admin-nav-btn" data-section="products">
          <span class="nav-icon bg-blue-600"><i class="fa-solid fa-boxes-stacked"></i></span>
          Products
        </button>
        <button class="admin-nav-btn" data-section="add-product">
          <span class="nav-icon bg-emerald-600"><i class="fa-solid fa-plus"></i></span>
          Add Product
        </button>
      </nav>

      <div class="border-t border-white/5 mt-5 pt-5">
        <div class="text-[10px] font-black text-gray-600 uppercase tracking-widest px-3 mb-3">External</div>
        <a href="/shop" target="_blank" class="admin-nav-btn block">
          <span class="nav-icon bg-orange-500"><i class="fa-solid fa-store"></i></span>
          View Shop
        </a>
        <a href="/admin/login" onclick="localStorage.removeItem('fm_admin_token')" class="admin-nav-btn block mt-1">
          <span class="nav-icon bg-red-600"><i class="fa-solid fa-right-from-bracket"></i></span>
          Sign Out
        </a>
      </div>

      <!-- User card at bottom -->
      <div class="mt-auto">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center">
              <i class="fa-solid fa-user text-white text-sm"></i>
            </div>
            <div>
              <div class="font-bold text-white text-sm">admin</div>
              <div class="text-xs text-gray-500">Superadmin</div>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <!-- ═══ MAIN CONTENT ═══════════════════════════════════════════════ -->
    <main class="flex-1 overflow-y-auto p-4 sm:p-6">

      <!-- Mobile nav pills -->
      <div class="md:hidden flex gap-2 overflow-x-auto pb-4 mb-6 -mx-4 px-4">
        <button class="mob-nav-btn active shrink-0" data-section="overview">
          <i class="fa-solid fa-gauge-high mr-1.5"></i>Overview
        </button>
        <button class="mob-nav-btn shrink-0" data-section="products">
          <i class="fa-solid fa-boxes-stacked mr-1.5"></i>Products
        </button>
        <button class="mob-nav-btn shrink-0" data-section="add-product">
          <i class="fa-solid fa-plus mr-1.5"></i>Add Product
        </button>
      </div>

      <!-- ── OVERVIEW ──────────────────────────────────────────────── -->
      <div id="section-overview" class="admin-section">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-2xl font-black text-gray-900">Dashboard Overview</h1>
            <p class="text-sm text-gray-400 mt-0.5">Welcome back, admin</p>
          </div>
          <button onclick="switchSection('add-product')"
            class="flex items-center gap-2 bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary-600/30">
            <i class="fa-solid fa-plus"></i>
            <span>Add Product</span>
          </button>
        </div>

        <!-- Stats grid -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center shadow-lg shadow-primary-600/25">
                <i class="fa-solid fa-boxes-stacked text-white text-base"></i>
              </div>
              <span class="text-xs font-bold text-primary-600 bg-primary-50 px-3 py-1 rounded-full">Active</span>
            </div>
            <div id="stat-total-products" class="text-4xl font-black text-gray-900 mb-1">0</div>
            <div class="text-sm text-gray-400 font-medium">Total Products</div>
          </div>

          <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-orange-500/25">
                <i class="fa-solid fa-star text-white text-base"></i>
              </div>
              <span class="text-xs font-bold text-orange-600 bg-orange-50 px-3 py-1 rounded-full">Featured</span>
            </div>
            <div id="stat-featured" class="text-4xl font-black text-gray-900 mb-1">0</div>
            <div class="text-sm text-gray-400 font-medium">Featured Items</div>
          </div>

          <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-red-400 to-rose-500 rounded-2xl flex items-center justify-center shadow-lg shadow-rose-500/25">
                <i class="fa-solid fa-triangle-exclamation text-white text-base"></i>
              </div>
            </div>
            <div id="stat-low-stock" class="text-4xl font-black text-gray-900 mb-1">0</div>
            <div class="text-sm text-gray-400 font-medium">Low Stock (&lt;10)</div>
          </div>

          <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-violet-500 to-purple-600 rounded-2xl flex items-center justify-center shadow-lg shadow-purple-600/25">
                <i class="fa-solid fa-tags text-white text-base"></i>
              </div>
            </div>
            <div id="stat-categories" class="text-4xl font-black text-gray-900 mb-1">0</div>
            <div class="text-sm text-gray-400 font-medium">Categories</div>
          </div>
        </div>

        <!-- Category breakdown -->
        <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-7">
          <div class="flex items-center justify-between mb-6">
            <h3 class="font-black text-gray-900">Products by Category</h3>
            <button onclick="switchSection('products')" class="text-xs font-bold text-primary-600 hover:text-primary-700 transition-colors">
              View All →
            </button>
          </div>
          <div id="cat-breakdown" class="space-y-4"></div>
        </div>
      </div>

      <!-- ── PRODUCTS ───────────────────────────────────────────────── -->
      <div id="section-products" class="admin-section hidden">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
          <div>
            <h1 class="text-2xl font-black text-gray-900">All Products</h1>
            <p id="prod-count-label" class="text-sm text-gray-400 mt-0.5"></p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
            <!-- Search -->
            <div class="relative">
              <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
              <input id="prod-search" type="text" placeholder="Search products, brands..."
                class="bg-white border-2 border-gray-200 focus:border-primary-400 rounded-2xl px-4 py-2.5 pl-10 text-sm w-full sm:w-60 focus:outline-none transition-all" />
            </div>
            <!-- Add button -->
            <button onclick="switchSection('add-product')"
              class="flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-500 active:scale-95 text-white font-bold text-sm px-6 py-2.5 rounded-2xl transition-all hover:shadow-lg hover:shadow-primary-600/30 whitespace-nowrap">
              <i class="fa-solid fa-plus text-sm"></i>
              Add New Product
            </button>
          </div>
        </div>

        <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="admin-table w-full min-w-[700px]">
              <thead>
                <tr>
                  <th class="pl-6">Product</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Stock</th>
                  <th>Featured</th>
                  <th class="pr-6">Actions</th>
                </tr>
              </thead>
              <tbody id="products-table-body">
                <tr><td colspan="6" class="text-center py-10 text-gray-400">Loading products...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ── ADD / EDIT PRODUCT ───────────────────────────────────────── -->
      <div id="section-add-product" class="admin-section hidden">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 id="form-title" class="text-2xl font-black text-gray-900">Add New Product</h1>
            <p class="text-sm text-gray-400 mt-0.5">Fill in the details below to list a new product</p>
          </div>
          <button id="cancel-edit-btn"
            class="hidden items-center gap-2 text-sm text-gray-500 hover:text-gray-900 font-bold border-2 border-gray-200 hover:border-gray-300 px-4 py-2 rounded-xl transition-all">
            <i class="fa-solid fa-xmark"></i>Cancel
          </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Form -->
          <div class="lg:col-span-2 bg-white rounded-3xl border border-gray-100 shadow-sm p-7">
            <input type="hidden" id="edit-product-id" />

            <!-- Section: Basic Info -->
            <div class="mb-7">
              <div class="flex items-center gap-3 mb-5 pb-3 border-b border-gray-100">
                <div class="w-8 h-8 bg-blue-50 rounded-xl flex items-center justify-center">
                  <i class="fa-solid fa-tag text-blue-600 text-xs"></i>
                </div>
                <h3 class="font-black text-gray-900 text-sm uppercase tracking-wide">Basic Information</h3>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Product Name <span class="text-red-500">*</span></label>
                  <input type="text" id="p-name" placeholder="e.g. Dove Beauty Bar Soap"
                    class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 text-sm focus:outline-none transition-all font-medium" required />
                </div>
                <div>
                  <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Brand <span class="text-red-500">*</span></label>
                  <input type="text" id="p-brand" placeholder="e.g. Dove"
                    class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 text-sm focus:outline-none transition-all font-medium" required />
                </div>
                <div>
                  <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Category <span class="text-red-500">*</span></label>
                  <select id="p-category"
                    class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 text-sm focus:outline-none transition-all font-medium appearance-none cursor-pointer" required>
                    <option value="">Select a category</option>
                    <option value="personal-care">🧴 Personal Care</option>
                    <option value="snacks">🍫 Snacks & Chocolates</option>
                    <option value="beverages">🧃 Beverages</option>
                    <option value="household">🧹 Household Cleaning</option>
                    <option value="dairy">🥛 Dairy & Eggs</option>
                    <option value="bakery">🍞 Bakery & Bread</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Unit / Weight <span class="text-red-500">*</span></label>
                  <input type="text" id="p-unit" placeholder="e.g. 100g, 500ml, 1kg"
                    class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 text-sm focus:outline-none transition-all font-medium" required />
                </div>
              </div>
            </div>

            <!-- Section: Pricing & Stock -->
            <div class="mb-7">
              <div class="flex items-center gap-3 mb-5 pb-3 border-b border-gray-100">
                <div class="w-8 h-8 bg-green-50 rounded-xl flex items-center justify-center">
                  <i class="fa-solid fa-indian-rupee-sign text-green-600 text-xs"></i>
                </div>
                <h3 class="font-black text-gray-900 text-sm uppercase tracking-wide">Pricing & Stock</h3>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                  <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Selling Price (₹) <span class="text-red-500">*</span></label>
                  <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm">₹</span>
                    <input type="number" id="p-price" placeholder="45" min="0" step="0.01"
                      class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 pl-8 text-sm focus:outline-none transition-all font-medium" required />
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">MRP / Original Price (₹)</label>
                  <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm">₹</span>
                    <input type="number" id="p-original-price" placeholder="55" min="0" step="0.01"
                      class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 pl-8 text-sm focus:outline-none transition-all font-medium" />
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Stock Qty <span class="text-red-500">*</span></label>
                  <input type="number" id="p-stock" placeholder="100" min="0"
                    class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 text-sm focus:outline-none transition-all font-medium" required />
                </div>
              </div>
              <!-- Discount preview -->
              <div id="discount-preview" class="hidden mt-3 gap-2 text-sm" style="display:none;align-items:center">
                <i class="fa-solid fa-tag text-green-600"></i>
                <span id="discount-text" class="text-green-700 font-bold"></span>
                <span class="text-gray-400">discount will be shown on product</span>
              </div>
            </div>

            <!-- Section: Description & Featured -->
            <div class="mb-7">
              <div class="flex items-center gap-3 mb-5 pb-3 border-b border-gray-100">
                <div class="w-8 h-8 bg-purple-50 rounded-xl flex items-center justify-center">
                  <i class="fa-solid fa-align-left text-purple-600 text-xs"></i>
                </div>
                <h3 class="font-black text-gray-900 text-sm uppercase tracking-wide">Description & Options</h3>
              </div>
              <div class="mb-4">
                <label class="block text-xs font-black text-gray-500 uppercase tracking-widest mb-2">Description</label>
                <textarea id="p-description" rows="3" placeholder="Brief product description..."
                  class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 text-sm focus:outline-none transition-all font-medium resize-none"></textarea>
              </div>
              <!-- Featured toggle -->
              <div class="flex items-center justify-between p-5 bg-gradient-to-r from-amber-50 to-orange-50 rounded-2xl border-2 border-amber-100 cursor-pointer" id="featured-toggle-area">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-star text-amber-500"></i>
                  </div>
                  <div>
                    <div class="font-bold text-gray-900 text-sm">Mark as Featured</div>
                    <div class="text-xs text-gray-500 mt-0.5">Featured products appear on the home page spotlight</div>
                  </div>
                </div>
                <!-- Custom toggle -->
                <label class="relative cursor-pointer" onclick="event.stopPropagation()">
                  <input type="checkbox" id="p-featured" class="sr-only peer" />
                  <div class="w-12 h-6 bg-gray-200 rounded-full peer peer-checked:bg-primary-600 transition-all duration-200 peer-checked:after:translate-x-6 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:shadow-md"></div>
                </label>
              </div>
            </div>

            <!-- Submit buttons -->
            <div class="flex gap-3 pt-4 border-t border-gray-100">
              <button type="button" id="form-submit-btn"
                class="flex-1 flex items-center justify-center gap-2.5 bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-500 hover:to-primary-400 text-white font-black py-4 rounded-2xl transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary-600/30 text-base active:scale-[0.98]">
                <i class="fa-solid fa-plus"></i>
                <span id="form-submit-text">Add Product</span>
              </button>
              <button type="button" id="cancel-form-btn"
                class="px-8 flex items-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-4 rounded-2xl transition-all text-base">
                <i class="fa-solid fa-xmark"></i>
                Cancel
              </button>
            </div>
          </div>

          <!-- Image upload sidebar -->
          <div class="space-y-5">
            <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
              <div class="flex items-center gap-3 mb-5 pb-3 border-b border-gray-100">
                <div class="w-8 h-8 bg-rose-50 rounded-xl flex items-center justify-center">
                  <i class="fa-solid fa-image text-rose-500 text-xs"></i>
                </div>
                <h3 class="font-black text-gray-900 text-sm uppercase tracking-wide">Product Image</h3>
              </div>

              <!-- Preview -->
              <div id="img-preview-wrap"
                class="w-full aspect-square rounded-2xl border-2 border-dashed border-gray-200 bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center mb-4 overflow-hidden relative cursor-pointer hover:border-primary-300 hover:bg-primary-50/20 transition-all"
                onclick="document.getElementById('p-image-file').click()">
                <div id="img-placeholder" class="text-center">
                  <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-sm">
                    <i class="fa-solid fa-cloud-arrow-up text-gray-300 text-2xl"></i>
                  </div>
                  <p class="text-xs font-bold text-gray-400">Click to upload image</p>
                  <p class="text-[10px] text-gray-300 mt-1">JPG, PNG, WEBP · Max 2MB</p>
                </div>
                <img id="img-preview" class="hidden absolute inset-0 w-full h-full object-contain p-4 bg-white" alt="Preview" />
              </div>

              <!-- Upload -->
              <input type="file" id="p-image-file" accept="image/*" class="hidden" />
              <button onclick="document.getElementById('p-image-file').click()"
                class="w-full flex items-center justify-center gap-2 bg-gray-900 hover:bg-gray-700 text-white font-bold text-sm py-3 rounded-2xl transition-all hover:-translate-y-0.5 mb-4">
                <i class="fa-solid fa-upload"></i>Upload Image
              </button>

              <!-- Or URL -->
              <div class="relative">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-gray-100"></div>
                </div>
                <div class="relative flex justify-center">
                  <span class="bg-white px-3 text-xs text-gray-400 font-medium">or paste image URL</span>
                </div>
              </div>
              <div class="mt-4">
                <input type="url" id="p-image-url" placeholder="https://example.com/image.jpg"
                  class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3 text-xs focus:outline-none transition-all" />
              </div>
            </div>

            <!-- Tips card -->
            <div class="bg-gradient-to-br from-primary-50 to-emerald-50 rounded-3xl border border-primary-100 p-5">
              <div class="flex items-center gap-2 mb-4">
                <i class="fa-solid fa-lightbulb text-primary-600 text-sm"></i>
                <h4 class="font-black text-primary-800 text-sm">Quick Tips</h4>
              </div>
              <ul class="space-y-2.5 text-xs text-primary-700">
                {[
                  'Use square images (1:1) for best look',
                  'Set MRP higher than price to show discount badge',
                  'Featured products appear on the home page',
                  'Stock < 10 shows "Low Stock" warning badge',
                  'Stock = 0 marks product as out of stock',
                ].map(tip => (
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-circle-check text-primary-500 mt-0.5 shrink-0"></i>
                    <span>{tip}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<style>
  .admin-nav-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 600;
    color: #6b7280;
    transition: all 0.2s;
    text-align: left;
    cursor: pointer;
    border: none;
    background: transparent;
  }
  .admin-nav-btn:hover { background: rgba(255,255,255,0.06); color: #fff; }
  .admin-nav-btn.active { background: rgba(22,163,74,0.15); color: #4ade80; }
  .nav-icon {
    width: 30px; height: 30px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 12px;
    color: white;
  }
  .mob-nav-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: 99px;
    font-size: 13px;
    font-weight: 700;
    transition: all 0.2s;
    border: 2px solid #e5e7eb;
    background: white;
    color: #6b7280;
    cursor: pointer;
  }
  .mob-nav-btn.active { background: #16a34a; color: white; border-color: #16a34a; }
  .admin-section {}
  .admin-table th {
    background: #f9fafb;
    color: #6b7280;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid #f3f4f6;
  }
  .admin-table td {
    padding: 14px 16px;
    font-size: 14px;
    color: #374151;
    border-bottom: 1px solid #f9fafb;
    vertical-align: middle;
  }
  .admin-table tr:last-child td { border-bottom: none; }
  .admin-table tr:hover td { background: #f9fafb; }
</style>
</Layout>

<script is:inline>
  // Auth guard
  if (localStorage.getItem("fm_admin_token") !== "fm_admin_authenticated") {
    window.location.href = "/admin/login";
  }

  // SweetAlert2 theme defaults
  const SA_DEFAULTS = {
    customClass: { popup: "rounded-3xl font-sans", confirmButton: "rounded-xl font-bold px-6 py-2.5", cancelButton: "rounded-xl font-bold px-6 py-2.5" },
    buttonsStyling: true,
  };

  // ── Section switching ──────────────────────────────────────────────
  function switchSection(name) {
    document.querySelectorAll(".admin-section").forEach(s => s.classList.add("hidden"));
    document.getElementById("section-" + name).classList.remove("hidden");
    document.getElementById("breadcrumb").innerHTML = `<i class="fa-solid fa-house text-xs text-gray-300 mr-2"></i><span>${name === 'overview' ? 'Dashboard' : name === 'products' ? 'Products' : 'Add Product'}</span>`;
    // Sync all nav buttons
    const allBtns = document.querySelectorAll(".admin-nav-btn[data-section], .mob-nav-btn[data-section]");
    allBtns.forEach(b => b.classList.toggle("active", b.dataset.section === name));
    if (name === "overview") loadOverview();
    if (name === "products") loadProductsTable();
  }
  window.switchSection = switchSection;

  document.querySelectorAll("[data-section]").forEach(btn => {
    btn.addEventListener("click", () => switchSection(btn.dataset.section));
  });

  // Logout
  document.getElementById("logout-btn").addEventListener("click", () => {
    Swal.fire({ ...SA_DEFAULTS, title: "Logout?", text: "You'll need to sign in again to access the admin.", icon: "question",
      showCancelButton: true, confirmButtonColor: "#ef4444", cancelButtonColor: "#6b7280",
      confirmButtonText: "Yes, logout", cancelButtonText: "Cancel" })
      .then(r => { if (r.isConfirmed) { localStorage.removeItem("fm_admin_token"); window.location.href = "/admin/login"; } });
  });

  // ── OVERVIEW ─────────────────────────────────────────────────────
  const CAT_LABELS = { "personal-care":"Personal Care","snacks":"Snacks & Chocs","beverages":"Beverages","household":"Household","dairy":"Dairy & Eggs","bakery":"Bakery" };
  const CAT_COLORS = { "personal-care":"bg-primary-500","snacks":"bg-orange-500","beverages":"bg-blue-500","household":"bg-purple-500","dairy":"bg-amber-500","bakery":"bg-rose-500" };

  function loadOverview() {
    const products = JSON.parse(localStorage.getItem("fm_products") || "[]");
    document.getElementById("stat-total-products").textContent = products.length;
    document.getElementById("stat-featured").textContent = products.filter(p => p.featured).length;
    document.getElementById("stat-low-stock").textContent = products.filter(p => p.stock > 0 && p.stock < 10).length;
    const catCounts = {};
    products.forEach(p => { catCounts[p.category] = (catCounts[p.category] || 0) + 1; });
    document.getElementById("stat-categories").textContent = Object.keys(catCounts).length;
    const total = products.length || 1;
    document.getElementById("cat-breakdown").innerHTML = Object.entries(catCounts)
      .sort((a,b) => b[1]-a[1])
      .map(([cat, count]) => {
        const pct = Math.round((count/total)*100);
        const bar = CAT_COLORS[cat] || "bg-gray-400";
        return `<div class="flex items-center gap-4">
          <div class="w-32 text-sm font-semibold text-gray-700 shrink-0">${CAT_LABELS[cat]||cat}</div>
          <div class="flex-1 h-2.5 bg-gray-100 rounded-full overflow-hidden"><div class="${bar} h-full rounded-full transition-all" style="width:${pct}%"></div></div>
          <div class="w-20 text-right text-xs text-gray-400 font-medium shrink-0">${count} items · ${pct}%</div>
        </div>`;
      }).join("");
  }

  // ── PRODUCTS TABLE ────────────────────────────────────────────────
  function loadProductsTable(searchQ = "") {
    let products = JSON.parse(localStorage.getItem("fm_products") || "[]");
    if (searchQ) { const q = searchQ.toLowerCase(); products = products.filter(p => p.name.toLowerCase().includes(q) || p.brand.toLowerCase().includes(q) || p.category.toLowerCase().includes(q)); }
    document.getElementById("prod-count-label").textContent = `${products.length} products`;
    const tbody = document.getElementById("products-table-body");
    if (!products.length) { tbody.innerHTML = `<tr><td colspan="6" class="text-center py-12 text-gray-400"><div class="text-4xl mb-2">📦</div><p>No products found.</p></td></tr>`; return; }
    tbody.innerHTML = products.map(p => {
      const d = p.originalPrice > p.price ? Math.round((1-p.price/p.originalPrice)*100) : 0;
      const catColor = { "personal-care":"bg-green-100 text-green-700","snacks":"bg-orange-100 text-orange-700","beverages":"bg-blue-100 text-blue-700","household":"bg-purple-100 text-purple-700","dairy":"bg-amber-100 text-amber-700","bakery":"bg-rose-100 text-rose-700" };
      let stockTag;
      if (p.stock === 0) stockTag = `<span class="inline-flex items-center gap-1 bg-red-100 text-red-600 text-xs font-bold px-3 py-1 rounded-full"><i class="fa-solid fa-circle-xmark text-[10px]"></i>Out of stock</span>`;
      else if (p.stock < 10) stockTag = `<span class="inline-flex items-center gap-1 bg-amber-100 text-amber-700 text-xs font-bold px-3 py-1 rounded-full"><i class="fa-solid fa-triangle-exclamation text-[10px]"></i>${p.stock} left</span>`;
      else stockTag = `<span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-semibold px-3 py-1 rounded-full"><i class="fa-solid fa-check text-[10px]"></i>${p.stock}</span>`;
      return `<tr>
        <td class="pl-6">
          <div class="flex items-center gap-3">
            <img src="${p.image}" alt="${p.name}" class="w-12 h-12 object-contain rounded-2xl bg-gray-50 p-1 border border-gray-100 shrink-0"
              onerror="this.src='https://placehold.co/80x80/16a34a/ffffff?text=P'" />
            <div>
              <div class="font-bold text-gray-900 text-sm">${p.name}</div>
              <div class="text-xs text-gray-400 mt-0.5">${p.brand} · ${p.unit}</div>
            </div>
          </div>
        </td>
        <td><span class="text-xs font-bold px-3 py-1.5 rounded-full ${catColor[p.category]||"bg-gray-100 text-gray-600"}">${CAT_LABELS[p.category]||p.category}</span></td>
        <td>
          <div class="font-black text-gray-900">₹${p.price}</div>
          ${d>0?`<div class="flex items-center gap-1.5 mt-0.5"><span class="text-xs text-gray-400 line-through">₹${p.originalPrice}</span><span class="text-xs font-bold text-green-600">${d}% off</span></div>`:""}
        </td>
        <td>${stockTag}</td>
        <td>
          <button onclick="toggleFeatured('${p.id}')"
            class="w-9 h-9 rounded-xl flex items-center justify-center transition-all ${p.featured?"bg-amber-100 hover:bg-amber-200 text-amber-500":"bg-gray-100 hover:bg-gray-200 text-gray-300"}"
            title="${p.featured?"Remove from featured":"Add to featured"}">
            <i class="fa-${p.featured?"solid":"regular"} fa-star text-sm"></i>
          </button>
        </td>
        <td class="pr-6">
          <div class="flex items-center gap-2">
            <button onclick="editProduct('${p.id}')" title="Edit"
              class="flex items-center gap-1.5 bg-blue-50 hover:bg-blue-100 text-blue-600 font-bold text-xs px-3 py-2 rounded-xl transition-all">
              <i class="fa-solid fa-pen-to-square text-xs"></i>Edit
            </button>
            <button onclick="deleteProduct('${p.id}')" title="Delete"
              class="flex items-center gap-1.5 bg-red-50 hover:bg-red-100 text-red-500 font-bold text-xs px-3 py-2 rounded-xl transition-all">
              <i class="fa-solid fa-trash-can text-xs"></i>Delete
            </button>
          </div>
        </td>
      </tr>`;
    }).join("");
  }

  document.getElementById("prod-search").addEventListener("input", function() { loadProductsTable(this.value.trim()); });

  // ── TOGGLE FEATURED ───────────────────────────────────────────────
  window.toggleFeatured = function(id) {
    const products = JSON.parse(localStorage.getItem("fm_products")||"[]");
    const idx = products.findIndex(p => p.id === id);
    if (idx > -1) { products[idx].featured = !products[idx].featured; localStorage.setItem("fm_products", JSON.stringify(products)); loadProductsTable(document.getElementById("prod-search").value.trim()); }
  };

  // ── DELETE ────────────────────────────────────────────────────────
  window.deleteProduct = function(id) {
    const products = JSON.parse(localStorage.getItem("fm_products")||"[]");
    const p = products.find(p => p.id === id);
    Swal.fire({ ...SA_DEFAULTS, title: "Delete Product?", html: `<p class="text-gray-500">This will permanently delete <strong class="text-gray-900">${p.name}</strong>. This action cannot be undone.</p>`,
      icon: "warning", showCancelButton: true, confirmButtonColor: "#ef4444", cancelButtonColor: "#6b7280",
      confirmButtonText: "<i class='fa-solid fa-trash-can mr-1.5'></i>Yes, delete it",
      cancelButtonText: "Cancel" })
      .then(r => {
        if (r.isConfirmed) {
          const updated = products.filter(p => p.id !== id);
          localStorage.setItem("fm_products", JSON.stringify(updated));
          loadProductsTable(document.getElementById("prod-search").value.trim());
          Swal.fire({ ...SA_DEFAULTS, title: "Deleted!", text: "Product removed successfully.", icon: "success", confirmButtonColor: "#16a34a", timer: 2000, showConfirmButton: false });
        }
      });
  };

  // ── EDIT ──────────────────────────────────────────────────────────
  window.editProduct = function(id) {
    const products = JSON.parse(localStorage.getItem("fm_products")||"[]");
    const p = products.find(p => p.id === id);
    if (!p) return;
    switchSection("add-product");
    document.getElementById("edit-product-id").value = p.id;
    document.getElementById("p-name").value = p.name;
    document.getElementById("p-brand").value = p.brand;
    document.getElementById("p-category").value = p.category;
    document.getElementById("p-unit").value = p.unit;
    document.getElementById("p-price").value = p.price;
    document.getElementById("p-original-price").value = p.originalPrice||"";
    document.getElementById("p-stock").value = p.stock;
    document.getElementById("p-description").value = p.description||"";
    document.getElementById("p-featured").checked = p.featured||false;
    document.getElementById("p-image-url").value = p.image && !p.image.startsWith("data:") ? p.image : "";
    if (p.image) { const pi = document.getElementById("img-preview"); pi.src = p.image; pi.classList.remove("hidden"); document.getElementById("img-placeholder").classList.add("hidden"); }
    document.getElementById("form-title").textContent = "Edit Product";
    document.getElementById("form-submit-text").textContent = "Update Product";
    document.getElementById("cancel-edit-btn").style.display = "flex";
  };

  // Cancel edit
  function resetForm() {
    document.getElementById("edit-product-id").value = "";
    ["p-name","p-brand","p-unit","p-description","p-image-url"].forEach(id => document.getElementById(id).value = "");
    document.getElementById("p-category").value = "";
    document.getElementById("p-price").value = "";
    document.getElementById("p-original-price").value = "";
    document.getElementById("p-stock").value = "";
    document.getElementById("p-featured").checked = false;
    document.getElementById("img-preview").classList.add("hidden");
    document.getElementById("img-placeholder").classList.remove("hidden");
    document.getElementById("img-preview").src = "";
    currentImageData = "";
    document.getElementById("form-title").textContent = "Add New Product";
    document.getElementById("form-submit-text").textContent = "Add Product";
    document.getElementById("cancel-edit-btn").style.display = "none";
    document.getElementById("discount-preview").classList.add("hidden");
  }
  document.getElementById("cancel-edit-btn").addEventListener("click", resetForm);
  document.getElementById("cancel-form-btn").addEventListener("click", () => { resetForm(); switchSection("products"); });

  // ── IMAGE UPLOAD ──────────────────────────────────────────────────
  let currentImageData = "";
  document.getElementById("p-image-file").addEventListener("change", function() {
    const file = this.files[0];
    if (!file) return;
    if (file.size > 2*1024*1024) { Swal.fire({ ...SA_DEFAULTS, icon:"error", title:"File Too Large", text:"Image must be under 2MB.", confirmButtonColor:"#16a34a" }); return; }
    const reader = new FileReader();
    reader.onload = e => {
      currentImageData = e.target.result;
      const pi = document.getElementById("img-preview");
      pi.src = currentImageData; pi.classList.remove("hidden");
      document.getElementById("img-placeholder").classList.add("hidden");
    };
    reader.readAsDataURL(file);
  });
  document.getElementById("p-image-url").addEventListener("input", function() {
    if (this.value) { const pi = document.getElementById("img-preview"); pi.src = this.value; pi.classList.remove("hidden"); document.getElementById("img-placeholder").classList.add("hidden"); currentImageData = ""; }
  });

  // ── DISCOUNT PREVIEW ──────────────────────────────────────────────
  function updateDiscountPreview() {
    const price = parseFloat(document.getElementById("p-price").value);
    const orig = parseFloat(document.getElementById("p-original-price").value);
    const preview = document.getElementById("discount-preview");
    if (price > 0 && orig > price) {
      const d = Math.round((1-price/orig)*100);
      document.getElementById("discount-text").textContent = `${d}% off`;
      preview.style.display = "flex";
    } else preview.style.display = "none";
  }
  document.getElementById("p-price").addEventListener("input", updateDiscountPreview);
  document.getElementById("p-original-price").addEventListener("input", updateDiscountPreview);

  // ── SUBMIT FORM ───────────────────────────────────────────────────
  function genPlaceholder(cat, name) {
    const c = {"personal-care":"16a34a","snacks":"f97316","beverages":"3b82f6","household":"8b5cf6","dairy":"f59e0b","bakery":"ef4444"}[cat]||"6b7280";
    return `https://placehold.co/400x400/${c}/ffffff?text=${encodeURIComponent(name.split(" ").slice(0,2).join(" "))}`;
  }

  document.getElementById("form-submit-btn").addEventListener("click", function() {
    const name = document.getElementById("p-name").value.trim();
    const brand = document.getElementById("p-brand").value.trim();
    const category = document.getElementById("p-category").value;
    const unit = document.getElementById("p-unit").value.trim();
    const price = parseFloat(document.getElementById("p-price").value);
    const stock = parseInt(document.getElementById("p-stock").value);

    if (!name||!brand||!category||!unit||isNaN(price)||isNaN(stock)) {
      Swal.fire({ ...SA_DEFAULTS, icon:"warning", title:"Missing Fields", text:"Please fill in all required fields (marked with *).", confirmButtonColor:"#16a34a" });
      return;
    }

    const id = document.getElementById("edit-product-id").value;
    const imageUrl = document.getElementById("p-image-url").value.trim();
    const image = currentImageData || imageUrl || genPlaceholder(category, name);
    const product = {
      id: id||"p"+Date.now(), name, brand, category, unit, price,
      originalPrice: parseFloat(document.getElementById("p-original-price").value)||price,
      stock, description: document.getElementById("p-description").value.trim(),
      featured: document.getElementById("p-featured").checked, image,
    };

    let products = JSON.parse(localStorage.getItem("fm_products")||"[]");
    if (id) { const idx = products.findIndex(p => p.id === id); if (idx > -1) products[idx] = product; }
    else products.push(product);
    localStorage.setItem("fm_products", JSON.stringify(products));

    Swal.fire({ ...SA_DEFAULTS, icon:"success", title: id?"Product Updated!":"Product Added!",
      text: `${name} has been ${id?"updated":"added"} to your store.`,
      confirmButtonColor:"#16a34a", confirmButtonText:"View Products",
      showCancelButton:true, cancelButtonText:"Add Another", cancelButtonColor:"#6b7280" })
      .then(r => { resetForm(); if (r.isConfirmed) switchSection("products"); });
  });

  // ── INIT ──────────────────────────────────────────────────────────
  document.addEventListener("DOMContentLoaded", () => {
    window.seedProducts && window.seedProducts();
    loadOverview();
  });

  // Featured toggle area click
  document.getElementById("featured-toggle-area").addEventListener("click", () => {
    const cb = document.getElementById("p-featured");
    cb.checked = !cb.checked;
  });
</script>
