---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin Login">
  <div class="min-h-screen flex">

    <!-- Left panel — brand -->
    <div class="hidden lg:flex w-[45%] bg-gradient-to-br from-[#0b1120] via-[#0f1f2e] to-[#0b1120] flex-col justify-between p-12 relative overflow-hidden">
      <!-- Blobs -->
      <div class="absolute top-0 left-0 w-96 h-96 bg-primary-600 rounded-full opacity-10 blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-0 right-0 w-80 h-80 bg-emerald-500 rounded-full opacity-10 blur-3xl translate-x-1/3 translate-y-1/3"></div>

      <!-- Logo -->
      <div class="flex items-center gap-3 relative z-10">
        <!-- <div class="w-11 h-11 bg-gradient-to-br from-primary-500 to-primary-700 rounded-2xl flex items-center justify-center shadow-xl shadow-primary-900/50">
          <i class="fa-solid fa-leaf text-white text-lg"></i>
        </div> -->
        <div>
          <div class="font-black text-xl text-white tracking-tight"><img src="/aayi-logo.png" width="100" height="40"/></div>
          <div class="text-[10px] font-bold text-primary-400 tracking-widest uppercase">Admin Portal</div>
        </div>
      </div>

      <!-- Middle content -->
      <div class="relative z-10">
        <h2 class="text-4xl font-black text-white leading-tight mb-4">
          Manage your<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-emerald-300">superstore</span><br/>
          from anywhere.
        </h2>
        <p class="text-gray-400 text-base leading-relaxed mb-10">Add products, manage inventory, track categories and keep your store running 24/7.</p>
        <div class="space-y-4">
          {[
            { icon:'fa-boxes-stacked',   title:'Product Management',  desc:'Add, edit, delete and manage all products' },
            { icon:'fa-chart-line',      title:'Store Analytics',      desc:'Track views, categories and stock levels' },
            { icon:'fa-image',           title:'Image Uploads',        desc:'Upload product images or paste URLs directly' },
          ].map(f => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-white/8 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                <i class={`fa-solid ${f.icon} text-primary-400 text-sm`}></i>
              </div>
              <div>
                <div class="font-bold text-white text-sm">{f.title}</div>
                <div class="text-gray-500 text-xs mt-0.5">{f.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom -->
      <div class="relative z-10">
        <p class="text-gray-600 text-xs">© 2025 AAYI Mart Supermarket</p>
      </div>
    </div>

    <!-- Right panel — form -->
    <div class="flex-1 flex items-center justify-center px-6 py-12 bg-gray-50">
      <div class="w-full max-w-md">

        <!-- Mobile logo -->
        <div class="lg:hidden flex items-center gap-3 mb-8">
          <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center shadow-lg">
            <i class="fa-solid fa-leaf text-white"></i>
          </div>
          <div>
            <div class="font-black text-lg text-gray-900">AAYI Mart</div>
            <div class="text-[10px] font-bold text-primary-500 tracking-widest uppercase">Admin Portal</div>
          </div>
        </div>

        <!-- Heading -->
        <div class="mb-8">
          <h1 class="text-3xl font-black text-gray-900 mb-1">Welcome back</h1>
          <p class="text-gray-500 text-sm">Sign in to manage your store</p>
        </div>

        <!-- Card -->
        <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-8">

          <form id="login-form" class="space-y-5">

            <!-- Username -->
            <div>
              <label class="block text-xs font-black text-gray-700 uppercase tracking-widest mb-2">Username</label>
              <div class="relative">
                <div class="absolute left-4 top-1/2 -translate-y-1/2 w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
                  <i class="fa-solid fa-user text-gray-500 text-xs"></i>
                </div>
                <input type="text" id="username" name="username" placeholder="admin"
                  class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3.5 pl-14 text-sm font-medium focus:outline-none transition-all placeholder:text-gray-300"
                  autocomplete="username" required />
              </div>
            </div>

            <!-- Password -->
            <div>
              <label class="block text-xs font-black text-gray-700 uppercase tracking-widest mb-2">Password</label>
              <div class="relative">
                <div class="absolute left-4 top-1/2 -translate-y-1/2 w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
                  <i class="fa-solid fa-lock text-gray-500 text-xs"></i>
                </div>
                <input type="password" id="password" name="password" placeholder="••••••••"
                  class="w-full bg-gray-50 border-2 border-gray-100 focus:border-primary-400 focus:bg-white rounded-2xl px-4 py-3.5 pl-14 pr-14 text-sm font-medium focus:outline-none transition-all placeholder:text-gray-300"
                  autocomplete="current-password" required />
                <button type="button" id="toggle-pw"
                  class="absolute right-4 top-1/2 -translate-y-1/2 w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-lg flex items-center justify-center transition-colors">
                  <i class="fa-solid fa-eye text-gray-400 text-xs"></i>
                </button>
              </div>
            </div>

            <!-- Remember me -->
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-2.5 cursor-pointer">
                <div class="relative">
                  <input type="checkbox" id="remember" class="sr-only peer" />
                  <div class="w-5 h-5 bg-gray-100 border-2 border-gray-200 rounded-md peer-checked:bg-primary-600 peer-checked:border-primary-600 transition-all"></div>
                  <i class="fa-solid fa-check absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-white text-[8px] opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none"></i>
                </div>
                <span class="text-sm text-gray-600 font-medium">Remember me</span>
              </label>
            </div>

            <!-- Submit -->
            <button type="submit" id="login-btn"
              class="w-full bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-500 hover:to-primary-400 text-white font-black py-4 rounded-2xl transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary-600/30 text-base active:scale-[0.98]">
              <i class="fa-solid fa-right-to-bracket mr-2"></i>
              <span id="login-text">Sign In to Dashboard</span>
            </button>
          </form>

          <!-- Divider -->
          <div class="flex items-center gap-3 my-6">
            <div class="flex-1 h-px bg-gray-100"></div>
            <span class="text-xs text-gray-400 font-medium">Demo credentials</span>
            <div class="flex-1 h-px bg-gray-100"></div>
          </div>

          <!-- Demo credentials -->
          <div class="bg-gradient-to-r from-primary-50 to-emerald-50 rounded-2xl p-5 border border-primary-100">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-primary-600 text-sm"></i>
                <span class="text-xs font-bold text-primary-700">Test Admin Credentials</span>
              </div>
              <button id="fill-demo"
                class="text-xs font-bold text-white bg-primary-600 hover:bg-primary-500 px-3 py-1.5 rounded-lg transition-colors">
                Autofill →
              </button>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="bg-white rounded-xl p-3 border border-primary-100">
                <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-0.5">Username</div>
                <div class="text-sm font-bold text-gray-900">admin</div>
              </div>
              <div class="bg-white rounded-xl p-3 border border-primary-100">
                <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-0.5">Password</div>
                <div class="text-sm font-bold text-gray-900">AAYI Mart@2024</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Back link -->
        <div class="text-center mt-6">
          <a href="/" class="text-sm text-gray-400 hover:text-gray-700 transition-colors flex items-center gap-2 justify-center font-medium">
            <i class="fa-solid fa-arrow-left text-xs"></i>Back to Store
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const ADMIN_USERNAME = "admin";
  const ADMIN_PASSWORD = "AAYI Mart@2024";

  if (localStorage.getItem("fm_admin_token") === "fm_admin_authenticated") {
    window.location.href = "/admin/dashboard";
  }

  document.getElementById("toggle-pw").addEventListener("click", function () {
    const pw = document.getElementById("password");
    const icon = this.querySelector("i");
    const isText = pw.type === "text";
    pw.type = isText ? "password" : "text";
    icon.className = isText ? "fa-solid fa-eye text-gray-400 text-xs" : "fa-solid fa-eye-slash text-gray-400 text-xs";
  });

  document.getElementById("fill-demo").addEventListener("click", () => {
    document.getElementById("username").value = "admin";
    document.getElementById("password").value = "AAYI Mart@2024";
  });

  document.getElementById("login-form").addEventListener("submit", function (e) {
    e.preventDefault();
    const btn = document.getElementById("login-btn");
    const txt = document.getElementById("login-text");
    btn.disabled = true;
    txt.textContent = "Signing in...";

    const username = document.getElementById("username").value.trim();
    const password = document.getElementById("password").value;

    setTimeout(() => {
      if (username === ADMIN_USERNAME && password === ADMIN_PASSWORD) {
        localStorage.setItem("fm_admin_token", "fm_admin_authenticated");
        localStorage.setItem("fm_admin_user", username);
        if (document.getElementById("remember").checked) {
          localStorage.setItem("fm_admin_remember", "1");
        }
        txt.textContent = "Redirecting...";
        window.location.href = "/admin/dashboard";
      } else {
        btn.disabled = false;
        txt.textContent = "Sign In to Dashboard";
        Swal.fire({
          icon: "error",
          title: "Login Failed",
          text: "Invalid username or password. Try: admin / AAYI Mart@2024",
          confirmButtonColor: "#16a34a",
          confirmButtonText: "Try Again",
          customClass: { popup: "rounded-3xl", confirmButton: "rounded-xl font-bold" }
        });
      }
    }, 800);
  });
</script>
