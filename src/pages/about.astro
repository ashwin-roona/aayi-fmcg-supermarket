---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="About Us — Our Story">
  <Header activePage="about" />

  <!-- Hero -->
  <section
    class="bg-gradient-to-br from-primary-700 to-primary-900 text-white py-20"
  >
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="section-label text-primary-300 mb-3">Who We Are</div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">
        Feeding Families,<br /><span class="text-yellow-300"
          >Building Communities</span>
      </h1>
      <p class="text-primary-200 text-lg max-w-2xl mx-auto">
        Since 2010, AAYI Mart has been Bengaluru's trusted supermarket —
        bringing fresh produce, daily essentials, and genuine products to your
        neighbourhood.
      </p>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="section-label">Our Story</div>
          <h2 class="section-title mb-4">
            From a Small Shop to a Supermarket Chain
          </h2>
          <p class="text-gray-600 mb-4 leading-relaxed">
            AAYI Mart started as a small neighbourhood grocery store in
            Koramangala in 2010. Founded by Rajan and Priya Kumar, the store was
            built on a simple belief — that every family deserves access to
            fresh, quality products at honest prices.
          </p>
          <p class="text-gray-600 mb-4 leading-relaxed">
            Over the years, we grew from a single 500 sq ft shop to a 15,000 sq
            ft supermarket with 5 outlets across Bengaluru. We now serve over
            10,000 families every month, offering more than 5,000 products from
            200+ brands.
          </p>
          <p class="text-gray-600 leading-relaxed">
            In 2024, we launched our online store to reach even more homes —
            with the same promise of freshness, quality, and great prices that
            has defined us for 14 years.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-primary-50 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-primary-600 mb-1">14+</div>
            <div class="text-sm font-medium text-gray-600">
              Years in Business
            </div>
          </div>
          <div class="bg-orange-50 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-accent-500 mb-1">10K+</div>
            <div class="text-sm font-medium text-gray-600">Happy Families</div>
          </div>
          <div class="bg-blue-50 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-blue-600 mb-1">5,000+</div>
            <div class="text-sm font-medium text-gray-600">Products</div>
          </div>
          <div class="bg-yellow-50 rounded-2xl p-6 text-center">
            <div class="text-4xl font-extrabold text-yellow-600 mb-1">5</div>
            <div class="text-sm font-medium text-gray-600">Store Locations</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <div class="section-label">What We Stand For</div>
        <h2 class="section-title">Our Core Values</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-7 shadow-card">
          <div
            class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mb-4"
          >
            <i class="fa-solid fa-leaf text-primary-600 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Freshness First</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            We source directly from farms and manufacturers. Every product is
            checked for freshness before hitting our shelves. No compromises.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-7 shadow-card">
          <div
            class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mb-4"
          >
            <i class="fa-solid fa-handshake text-green-600 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">
            Trust &amp; Transparency
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Honest pricing with no hidden charges. What you see is what you pay.
            All our products are 100% genuine and FSSAI certified.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-7 shadow-card">
          <div
            class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-4"
          >
            <i class="fa-solid fa-heart text-blue-600 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Community First</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            We support local farmers and small businesses. 30% of our fresh
            produce is sourced directly from local farms within 100km of
            Bengaluru.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-7 shadow-card">
          <div
            class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center mb-4"
          >
            <i class="fa-solid fa-seedling text-yellow-600 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Sustainability</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            We've eliminated single-use plastic bags across all our stores. Our
            packaging is 80% recyclable and we have a composting program for
            food waste.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-7 shadow-card">
          <div
            class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mb-4"
          >
            <i class="fa-solid fa-star text-purple-600 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Quality Assured</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Every batch of products goes through a rigorous quality check. We
            work only with verified suppliers who meet our strict quality
            standards.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-7 shadow-card">
          <div
            class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center mb-4"
          >
            <i class="fa-solid fa-users text-red-600 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Customer Delight</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Your satisfaction is our greatest reward. From easy returns to 24/7
            support, we go the extra mile to make your shopping experience
            delightful.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <div class="section-label">The People Behind AAYI Mart</div>
        <h2 class="section-title">Meet Our Team</h2>
        <p class="text-gray-500 text-sm max-w-xl mx-auto mt-2">A passionate team dedicated to bringing fresh, quality products to every home in Bengaluru.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {
          [
            {
              name: "Rajan Kumar",
              role: "Founder & CEO",
              photo: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop&q=80&auto=format",
              badge: "bg-primary-100 text-primary-700",
            },
            {
              name: "Priya Kumar",
              role: "Co-Founder & COO",
              photo: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&h=300&fit=crop&q=80&auto=format",
              badge: "bg-orange-100 text-orange-700",
            },
            {
              name: "Arjun Sharma",
              role: "Head of Operations",
              photo: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&h=300&fit=crop&q=80&auto=format",
              badge: "bg-blue-100 text-blue-700",
            },
            {
              name: "Meera Nair",
              role: "Head of Procurement",
              photo: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=300&h=300&fit=crop&q=80&auto=format",
              badge: "bg-purple-100 text-purple-700",
            },
          ].map((member) => (
            <div class="group text-center">
              <div class="relative w-28 h-28 md:w-36 md:h-36 mx-auto mb-4">
                <img
                  src={member.photo}
                  alt={member.name}
                  class="w-full h-full object-cover rounded-3xl border-4 border-white shadow-xl group-hover:scale-105 transition-transform duration-300"
                  onerror="this.onerror=null;this.src='https://placehold.co/300x300/16a34a/ffffff?text=AM'"
                />
                <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-primary-500 rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fa-solid fa-check text-white text-xs"></i>
                </div>
              </div>
              <h4 class="font-bold text-gray-900 text-base">{member.name}</h4>
              <span class={`inline-block text-xs font-bold px-3 py-1 rounded-full mt-1.5 ${member.badge}`}>{member.role}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-primary-600 text-white text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-bold mb-4">Start Shopping with Us Today</h2>
      <p class="text-primary-100 mb-8">
        Join 10,000+ happy families who trust AAYI Mart for their daily
        essentials.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="/shop"
          class="bg-white text-primary-700 font-bold px-8 py-3.5 rounded-xl hover:bg-primary-50 transition-colors"
        >
          <i class="fa-solid fa-store mr-2"></i>Shop Now
        </a>
        <a
          href="/contact"
          class="border-2 border-white/50 text-white font-semibold px-8 py-3.5 rounded-xl hover:bg-white/10 transition-colors"
        >
          <i class="fa-solid fa-envelope mr-2"></i>Contact Us
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
