---
---
<footer class="bg-[#0b1120] text-gray-400 mt-16">
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-5">
          <!-- <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center shadow-lg shadow-primary-900/40">
            <i class="fa-solid fa-leaf text-white text-base"></i>
          </div> -->
          <div>
            <div class="font-black text-lg text-white tracking-tight"><img src="/aayi-logo.png" alt="AAYI Mart logo" width="100" height="40" class="object-contain" /></div>
            <div class="text-[10px] font-bold text-primary-500 tracking-widest uppercase">Supermarket</div>
          </div>
        </div>
        <p class="text-sm text-gray-500 leading-relaxed mb-6">Your trusted neighbourhood supermarket for fresh produce, daily essentials, and everything in between — delivered fast.</p>
        <div class="flex gap-2.5">
          {[
            { icon:'fa-facebook-f', href:'#' },
            { icon:'fa-instagram',  href:'#' },
            { icon:'fa-x-twitter',  href:'#' },
            { icon:'fa-youtube',    href:'#' },
          ].map(s => (
            <a href={s.href} class="w-9 h-9 bg-white/5 hover:bg-primary-600 border border-white/10 hover:border-primary-500 rounded-xl flex items-center justify-center transition-all duration-200">
              <i class={`fa-brands ${s.icon} text-xs text-gray-400 hover:text-white`}></i>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h5 class="text-xs font-black text-white uppercase tracking-widest mb-5">Quick Links</h5>
        <ul class="space-y-3 text-sm">
          {[
            { href:'/',           label:'Home' },
            { href:'/shop',       label:'Shop All' },
            { href:'/categories', label:'Categories' },
            { href:'/about',      label:'About Us' },
            { href:'/contact',    label:'Contact' },
            { href:'/cart',       label:'My Cart' },
          ].map(l => (
            <li><a href={l.href} class="text-gray-500 hover:text-primary-400 transition-colors font-medium">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h5 class="text-xs font-black text-white uppercase tracking-widest mb-5">Categories</h5>
        <ul class="space-y-3 text-sm">
          {[
            { href:'/shop?cat=personal-care', label:'Personal Care' },
            { href:'/shop?cat=snacks',        label:'Snacks & Chocolates' },
            { href:'/shop?cat=beverages',     label:'Beverages' },
            { href:'/shop?cat=household',     label:'Household Cleaning' },
            { href:'/shop?cat=dairy',         label:'Dairy & Eggs' },
            { href:'/shop?cat=bakery',        label:'Bakery & Bread' },
          ].map(l => (
            <li><a href={l.href} class="text-gray-500 hover:text-primary-400 transition-colors font-medium">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h5 class="text-xs font-black text-white uppercase tracking-widest mb-5">Contact Us</h5>
        <ul class="space-y-4 text-sm">
          <li class="flex gap-3 items-start">
            <div class="w-7 h-7 bg-white/5 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <i class="fa-solid fa-location-dot text-primary-500 text-xs"></i>
            </div>
            <span class="text-gray-500 leading-relaxed">42, Market Road, Koramangala,<br/>Bengaluru – 560034</span>
          </li>
          <li class="flex gap-3 items-center">
            <div class="w-7 h-7 bg-white/5 rounded-lg flex items-center justify-center shrink-0">
              <i class="fa-solid fa-phone text-primary-500 text-xs"></i>
            </div>
            <a href="tel:+918012345678" class="text-gray-500 hover:text-primary-400 transition-colors font-medium">+91 80123 45678</a>
          </li>
          <li class="flex gap-3 items-center">
            <div class="w-7 h-7 bg-white/5 rounded-lg flex items-center justify-center shrink-0">
              <i class="fa-solid fa-envelope text-primary-500 text-xs"></i>
            </div>
            <a href="mailto:hello@aayimart.in" class="text-gray-500 hover:text-primary-400 transition-colors font-medium">hello@aayimart.in</a>
          </li>
          <li class="flex gap-3 items-center">
            <div class="w-7 h-7 bg-white/5 rounded-lg flex items-center justify-center shrink-0">
              <i class="fa-solid fa-clock text-primary-500 text-xs"></i>
            </div>
            <span class="text-gray-500">Mon–Sun: 7 AM – 10 PM</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Trust strip -->
  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-5">
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-gray-600">
        <span class="flex items-center gap-2"><i class="fa-solid fa-truck-fast text-primary-500"></i>Free delivery ₹499+</span>
        <span class="flex items-center gap-2"><i class="fa-solid fa-rotate-left text-primary-500"></i>Easy 7-day returns</span>
        <span class="flex items-center gap-2"><i class="fa-solid fa-shield-halved text-primary-500"></i>100% Secure payments</span>
        <span class="flex items-center gap-2"><i class="fa-solid fa-leaf text-primary-500"></i>FSSAI Certified</span>
        <span class="flex items-center gap-2"><i class="fa-solid fa-headset text-primary-500"></i>24/7 Support</span>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-600">
      <p>© 2025 AAYI Mart Supermarket. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="#" class="hover:text-gray-400 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-gray-400 transition-colors">Terms of Service</a>
        <a href="/admin/login" class="hover:text-gray-400 transition-colors flex items-center gap-1"><i class="fa-solid fa-lock text-[10px]"></i>Admin</a>
      </div>
    </div>
  </div>
</footer>
